# systemd USER unit — Star Learner ops log portal on loopback :8771.
# nginx /logs is basic-auth'd (nakatomi.htpasswd) and proxies here.
#
#   cp deploy/starlearner-logs.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now starlearner-logs
#
[Unit]
Description=Star Learner ASR log portal (loopback :8771)
After=network-online.target starlearner-asr.service

[Service]
WorkingDirectory=%h/dev/star_learning
ExecStart=/usr/bin/python3 %h/dev/star_learning/deploy/log_portal.py
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
