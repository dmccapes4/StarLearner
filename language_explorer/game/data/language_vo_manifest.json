	"be02f78747b0ed82d25bdaa2824bd37b": "Tap a cover once to hear about the book.",
	"ae1343c23e024ec4052656d74c23b890": "Tap the same cover again within five seconds to open it.",
	"193ad649afcb3defc47e6ff7c2c1eac2": "Tap a word to spell it.",
	"3956ec512850167edf1a860ee5381177": "Read the page slowly, or go to the next page.",
