	"8fc42c6ddf9966db3b09e84365034357": "the",
	"60a7fcdfe52bf79cc2f95e1ab65eac1c": "fields.",
	"27722b134a7f6acf21872e55a0270fe5": "Choose Sentences to match pictures with red words.",
	"f3dd89381eebc8366888637c8e092727": "Choose Books to read a story one page at a time.",
	"3e64d70bee01a4333c5b9f85190b4b88": "Elige Oraciones para unir imágenes con palabras rojas.",
