	"e22864336bd8b265bcd2d0435462e1f4": "lived",
	"23a58bf9274bedb19375e527a0744fa9": "with",
	"0e66be14b86bd30bf4fc84357763b591": "their",
	"b8e18040dc07eead8e6741733653a740": "Mother",
