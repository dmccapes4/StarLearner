; Engine configuration file.
; Math Explorer — a Star Learner title. Make the numbers alive.

config_version=5

[application]

config/name="Math Explorer"
config/description="Make math visible: counting cubes, coins, and word problems, narrated and animated."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://icon.svg"

[audio]

general/text_to_speech=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=600
window/size/window_width_override=1280
window/size/window_height_override=600
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[rendering]

renderer/rendering_method="mobile"
environment/defaults/default_clear_color=Color(0.10, 0.12, 0.20, 1)
